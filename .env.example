# PatchPilot Environment Configuration Example
# Copy to .env or set in your environment if custom defaults are required.
# Note: PatchPilot does NOT require any external/paid API keys.

PATCHPILOT_MODEL_NAME=qwen3.5:4b
PATCHPILOT_OLLAMA_BASE_URL=http://localhost:11434
PATCHPILOT_REQUEST_TIMEOUT_SECONDS=120
PATCHPILOT_MAX_REPAIR_ATTEMPTS=3
PATCHPILOT_MAX_AGENT_STEPS=12
PATCHPILOT_MAX_TOOL_CALLS=24
PATCHPILOT_MAX_FILE_BYTES=200000
PATCHPILOT_MAX_CONTEXT_CHARACTERS=50000
PATCHPILOT_TEST_TIMEOUT_SECONDS=120
PATCHPILOT_MAX_COMMAND_OUTPUT_CHARACTERS=20000
PATCHPILOT_DATA_DIR=.patchpilot-data
